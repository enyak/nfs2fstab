# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=07F9-AD6B                            /efi           vfat    fmask=0137,dmask=0027 0 2
UUID=19037209-49b0-42b2-9ac4-8bb6541c078e /              btrfs   subvol=/@,noatime,compress=zstd 0 0
UUID=19037209-49b0-42b2-9ac4-8bb6541c078e /home          btrfs   subvol=/@home,noatime,compress=zstd 0 0
UUID=19037209-49b0-42b2-9ac4-8bb6541c078e /var/cache     btrfs   subvol=/@cache,noatime,compress=zstd 0 0
UUID=19037209-49b0-42b2-9ac4-8bb6541c078e /var/log       btrfs   subvol=/@log,noatime,compress=zstd 0 0
UUID=0f0c4c8a-fc6d-46b6-b22d-c41e03de1d99 swap           swap    defaults   0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0

#upphittat-init
//192.168.100.23/upphittat /mnt/upphittat cifs credentials=/etc/samba/upphittat.cred,_netdev,uid=1000,gid=1000,x-systemd.automount 0 0
#borttappat-init
//192.168.100.23/borttappat /mnt/borttappat cifs credentials=/etc/samba/borttappat.cred,_netdev,uid=1000,gid=1000,x-systemd.automount 0 0

